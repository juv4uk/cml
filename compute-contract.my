; compute-contract.my — analysis-only contract for heterogeneous execution
; This does not extend my-lisp semantics and does not claim a GPU backend.

((kind . cml-compute-contract)
 (version . (0 2))
 (status . analysis-only)
 (authority . ((language-semantics . my-lisp)
               (compute-analysis . cml)
               (physical-capabilities . backend)))
 (execution-shapes . (scalar element-wise reduction irregular))
 (effects . (pure allocating stateful unknown))
 (storage-classes . (scalar linked-list contiguous-buffer unknown))
 (numeric-domains . (exact fixed-width-integer inexact-float unknown))
 (gpu-admission . ((required-shape . (element-wise reduction))
                   (required-effect . pure)
                   (required-storage . contiguous-buffer)
                   (required-numeric-domain . (fixed-width-integer inexact-float))
                   (unknown-facts . reject)
                   (fallback . cpu)))
 (semantic-invariants . ((implicit-exact-to-inexact-conversion . forbidden)
                         (backend-selection-changes-result . forbidden)
                         (source-language-gpu-primitive . absent)))
 (current-boundary . ((bulk-forms-recognized . (map reduce))
                      (typed-buffer-ir . present-from-my-lisp-contract-2.2)
                      (typed-buffer-elements . (i32 f32))
                      (cpu-compute-backend . absent)
                      (gpu-emitter . absent)
                      (automatic-offload . absent)))
 (implementation . ((analysis . "src/compute.rs")
                    (buffer-ir . "src/ir.rs")
                    (tests . "tests/compute_analysis_test.rs tests/typed_buffer_ir_test.rs"))))
