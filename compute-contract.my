; compute-contract.my — analysis-only contract for heterogeneous execution
; This does not extend my-lisp semantics or claim physical-GPU execution.

((kind . cml-compute-contract)
 (version . (0 27))
 (status . experimental-runtime)
 (authority . ((language-semantics . my-lisp)
               (compute-analysis . cml)
               (physical-capabilities . backend)))
 (execution-shapes . (scalar element-wise reduction irregular))
 (effects . (pure allocating stateful unknown))
 (storage-classes . (scalar linked-list contiguous-buffer unknown))
 (numeric-domains . (exact fixed-width-integer inexact-float unknown))
 (gpu-admission . ((required-shape . (element-wise reduction))
                   (required-effect . pure)
                   (required-storage . contiguous-buffer)
                   (required-numeric-domain . (fixed-width-integer inexact-float))
                   (required-i32-overflow-proof . true)
                   (f32-rounding-contract . affine-x-plus-integer-per-literal-bit-equivalence)
                   (unknown-facts . reject)
                   (fallback . cpu)))
 (semantic-invariants . ((implicit-exact-to-inexact-conversion . forbidden)
                         (i32-addition . checked-overflow)
                         (backend-selection-changes-result . forbidden)
                         (source-language-gpu-primitive . absent)))
 (current-boundary . ((bulk-forms-recognized . (numeric-buffer-map map reduce))
                      (typed-buffer-ir . present-from-my-lisp-contract-2.2)
                      (typed-buffer-elements . (i32 f32))
                      (kernel-ir . (parameter exact-integer checked-add))
                      (cpu-compute-backend . (present-reference i32-map-range-proven f32-map-affine-proven))
                      (gpu-emitter . (wgsl-source-only admitted-map-regions))
                      (cuda-emitter . (cuda-c-source-only admitted-map-regions))
                      (cuda-runtime . (optional-feature gpu-cuda
                                       live-device-discovery
                                       planner-descriptor
                                       nvrtc-to-ptx
                                       driver-launch-readback))
                      (gpu-runtime . (optional-feature gpu-wgpu
                                      adapter-evidence-returned
                                      default-policy-gpu-only
                                      explicit-software-adapter-probe
                                      storage-buffer-dispatch-readback))
                      (runtime-live-evidence . llvmpipe-cpu-vulkan-pass)
                      (physical-gpu-evidence . (nvidia-gtx-1050-ti
                                                cuda-device-zero
                                                i32-map-pass))
                      (accelerator-selection . (live-descriptors-only
                                                capability-status-before-selection
                                                portable-first
                                                vendor-optimized
                                                cpu-adapters-rejected))
                      (vendor-paths . ((nvidia . (wgpu cuda-live))
                                       (amd . (wgpu rocm-planned))
                                       (intel . (wgpu oneapi-level-zero-planned))))
                      (automatic-offload . absent)))
 (execution-graph . ((status . registered-backends-m1)
                     (nodes . (id operation logical-input logical-output dependencies target))
                     (values . (buffer lisp-word))
                     (operations . (numeric-buffer-map fpga-program))
                     (targets . (cpu gpu fpga))
                     (implemented-executors . (cpu gpu-cuda gpu-wgpu fpga-command-bridge))
                     (backend-registration . explicit-name-to-node-executor)
                     (physical-evidence . ((gpu . (nvidia-gtx-1050-ti cuda-device-zero graph-map-pass))
                                           (fpga . (gw5a-25a windows-com4 graph-program-pass tagged-word-7))
                                           (heterogeneous . (cpu cuda fpga ordered-live-graph-pass))))
                     (heterogeneous-live-result . ((execution-order . (cpu cuda fpga))
                                                   (cpu-buffer . (2 3 4))
                                                   (cuda-buffer . (3 4 5))
                                                   (fpga-word . 7)))
                     (physical-evidence-scope . ((fpga . one-program-path-not-blanket-conformance)
                                                 (heterogeneous . scheduler-order-results-and-host-staged-fpga-input-not-direct-device-transfer)))
                     (cross-device-payload-transfer . (direct-device-to-device-absent host-staged-buffer-to-register-proven)))
                     (edge-classes . ((data . typed-value-with-explicit-producer-dependency)
                                      (control . dependency-only)))
                     (buffer-transfer . host-staged-materialized-graph-value)
                     (fpga-input-edge . (host-staged-register-input-explicit control-dependency-only-for-jobs-without-input))
                     (typed-fpga-input-policy . ((empty-buffer . reject)
                                                 (prepopulated-register-inputs . reject)
                                                 (unsupported-representation . reject)))
                     (implicit-source-order-dataflow . forbidden)
                     (unregistered-targets . fail-closed)
                     (publication . atomic-on-whole-graph-success)
                     (raw-cross-device-pointers . forbidden)))
 (fpga-job-protocol . ((version . 1)
                       (status . command-transport-m2c)
                       (wire-authority . fpga-lisp-isa-1.1)
                       (bootloader-frame . ((legacy . (u16-le-word-count u32-le-program-words))
                                            (extended-register-inputs . (rtl-simulation-proven host-bridge-targeted-tested physical-com4-confirmed-one-path))))
                       (cml-register-input-encoding . present-validated)
                       (register-input-contract . (maximum-16 unique-registers-r0-r15 opaque-u32-tagged-words))
                       (monitor-queries . ((result-register . 0x01)
                                           (error-status . 0x04)))
                       (result . signed-28-bit-fixnum-or-named-error)
                       (transport . (abstract command-process-binary-stdio))
                       (execution-graph-attachment . (mock-transport-confirmed physical-com4-confirmed-typed-buffer-input))
                       (physical-bridge . (windows-python-pyserial-com4))
                       (physical-device-evidence . (gw5a-25a windows-com4 graph-program-pass tagged-word-7 no-hardware-error))))
 (implementation . ((analysis . "src/compute.rs")
                    (buffer-ir . "src/ir.rs")
                    (cpu-reference . "src/compute.rs::CpuComputeBackend")
                    (wgsl-emitter . "src/gpu_wgsl.rs")
                    (cuda-emitter . "src/gpu_cuda.rs")
                    (cuda-runtime . "src/gpu_cuda_runtime.rs")
                    (wgpu-runtime . "src/gpu_wgpu_runtime.rs")
                    (accelerator-planner . "src/accelerator.rs")
                    (execution-graph . "src/execution.rs")
                    (execution-scheduler . "src/execution_scheduler.rs")
                    (execution-value-store . "src/execution_store.rs")
                    (fpga-job-protocol . "src/fpga_transport.rs")
                    (differential-oracle . "my-lisp path dev-dependency")
                    (physical-fpga-bridge . "../fpga-lisp/job_transport.py")
                    (tests . "tests/compute_analysis_test.rs tests/typed_buffer_ir_test.rs tests/cpu_compute_backend_test.rs tests/cpu_compute_differential_test.rs tests/execution_graph_test.rs tests/execution_graph_cuda_live_test.rs tests/execution_graph_fpga_test.rs tests/execution_graph_fpga_live_test.rs tests/execution_graph_heterogeneous_live_test.rs tests/fpga_transport_test.rs"))))
