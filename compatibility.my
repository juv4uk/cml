; compatibility.my — the explicit boundary tested by this CML revision
; Явна межа, яку перевіряє ця ревізія CML.
; Die von dieser CML-Revision geprüfte explizite Grenze.

((kind . cml-compatibility)
 (compiler-version . (0 3 0))
 (language . ((repository . juv4uk/my-lisp)
              (contract . (2 0))
              (tested-sha . "164608cc2b1c08b815362551d6a9483fa762db7b")))
 (target . ((repository . juv4uk/fpga-lisp)
            (isa . (1 0))
            (tested-sha . "6c08e42975eb05eb143ee4cc66bcc759b6f92a1b")))
 (pipeline . (parse macro-expand compile assemble simulate compare))
 (supported . (integer symbol nil true quote proper-list dotted-list
               cond lambda application cons car cdr eq atom equal? defmacro
               def recursive-def-letrec
               let-as-lambda-lowering variadic-up-to-eight-arguments))
 (representational-substitutions . ((source-string . target-symbol)))
 (contract-2.0-migration . ((change . "apostrophe-no-longer-quote-reader-sugar")
                            (fixed-in . "src/parser.rs, commit c631dbf")
                            (note . "a leading ' used to auto-expand into (quote ...); now folds into the identifier it's touching, matching real my-lisp's own apostrophe_is_no_longer_quote_sugar_but_part_of_symbol parser test. explicit (quote ...) is required from here on -- tests/fixtures/conformance.my already used only that form, which is why this gap survived undetected until a live contract-drift check found it")))
 (conformance . ((tier-1 . partial)
                 (tier-1-fixtures-tagged . 35)
                 (tier-1-fixtures-skipped . 3)
                 (tier-1-skip-reason . inexact-numbers-untagged-in-isa)
                 (structured-result-decoder . atoms-fixnums-proper-and-dotted-lists)
                 (error-results . static-arity-and-symbol-plus-fpga-runtime-type)
                 (fixture-specific-skips . (inexact-numbers))))
 (limitations . (no-inexact-numbers no-rationals no-canonical-strings
                 no-more-than-eight-call-arguments))
 (target-diagnostics . ((mechanism . "validate_ir pre-pass in src/compiler.rs, runs before any assembly is emitted")
                        (checks . (call-arguments-exceed-eight-registers
                                   integer-literal-exceeds-loadi-16-bit-magnitude))
                        (note . "both were previously silent target-corruption risks: a 9th+ call argument was never even evaluated (compile_generic_call only compiled args[..8]), and an out-of-range literal truncated into LOADI's 16-bit immediate. Both now fail to compile via CompileError instead. fpga-lisp path only -- c_backend.rs has no 8-arg ceiling since args is a real cons-list, and its own CompileError::Unsupported already covers unrepresentable IR shapes.")))
 (defmacro . ((mechanism . compile-time-only-source-transform)
              (implementation . "src/macros.rs")
              (semantics . (collect-top-level-defmacro
                            bind-params-to-raw-unevaluated-call-site-asts
                            evaluate-body-with-a-tree-walking-meta-evaluator
                            substitute-result-at-call-site-and-re-expand-for-nesting))
              (meta-evaluator-primitives . (quote cons car cdr atom eq cond))
              (never-reaches-fpga . true)
              (limitation . "macro body arity/param binding follows the same fixed/variadic/dotted rules as compile_lambda; no hygiene, no gensym")
              (example . "(defmacro my-list items (cons (quote quote) (cons items (quote ())))) (my-list 1 2 3) => (1 2 3)")))
 (def . ((mechanism . letrec-placeholder-pair-plus-setcdr-backpatch)
         (implementation . "compile_def in src/compiler.rs")
         (semantics . (extend-env-with-name-dot-nil-placeholder-before-compiling-value
                       compile-value-so-a-lambda-captures-the-extended-env
                       setcdr-backpatch-the-placeholders-cdr-to-the-compiled-value))
         (supports . (self-recursion forward-reference-to-earlier-defs))
         (does-not-support . "two mutually recursive defs where the first calls the second before the second is defined -- would need two-pass forward declaration, not implemented")
         (status . working-real-iverilog-verified)
         (known-issues . ((r4-env-clobber-in-compile-cond . fixed-e73f93a)
                          (cross-argument-r1-r3-clobber-in-compile-generic-call . fixed-166dffa)))
         (example . "(def length-onto (lambda (values acc) (cond ((atom values) acc) (t (length-onto (cdr values) (+ acc 1)))))) (def length (lambda (values) (length-onto values 0))) (length (quote (a b c))) => 3, verified end-to-end against core.my's own length/length-onto pair, see evidence/length/")))
 (equal? . ((mechanism . native-fpga-subroutine)
            (implementation . "cml_equal in src/compiler.rs")
            (algorithm . worklist-on-r11-no-call-ret-recursion)
            (rationale . "avoids depending on the still-unverified letrec/self-referential-closure mechanism (fpga-lisp plan item 24)")
            (example . "(equal? (quote (p . 0)) (cons (quote p) 0)) => TRUE")
            (status . working-real-iverilog-verified)
            (known-issues . ((r1-clobber-in-nested-two-arg-primitive-calls . fixed-af64449)))
            (retracted-false-positive . "a prior local run reported cml_equal hanging on this exact fixture; root cause was an insufficient wall-clock timeout on cold vvp startup (30-45s+ for this binary size on this machine), not a hardware or logic bug -- confirmed working with a longer timeout, see ecosystem-status.md")))
 (verification . ((equal? . real-iverilog-run-passed-locally)
                  (defmacro . real-iverilog-run-passed-locally)
                  (ci-workflow . ".github/workflows/ci.yml")
                  (ci-status-check-method . "REST API conclusion field via /repos/.../actions/runs?head_sha=..., never the rendered HTML /actions page")
                  (log . "ecosystem-status.md")))
 (c-backend . ((status . "second, non-fpga-lisp compilation target; docs/heterogeneous-backends.md step 2")
               (implementation . "src/c_backend.rs")
               (shares-frontend-with-fpga-lisp-target . true)
               (note . "parse/macro-expand/lower (ast::Expr -> ir::Ir) is identical to the fpga-lisp pipeline above; c-backend only differs from compile assemble simulate onward -- it consumes the same ir::Ir compiler.rs does, not a separate frontend")
               (pipeline . (parse macro-expand lower emit-c gcc run compare))
               (supported . (integer nil true quote-integer quote-symbol
                             quote-proper-list quote-dotted-list variable
                             lambda-fixed-arity lambda-variadic lambda-bare-symbol-params
                             application cond let structural-equal? def
                             recursive-def-letrec))
               (runtime . ((representation . "tagged-union Value struct (TAG_NIL/TRUE/INT/SYM/CONS/CLOSURE), heap-allocated via malloc, never freed")
                           (environment . "mutable-cons alist chain, same conceptual model as fpga-lisp's cml_lookup")
                           (self-recursive-def . "letrec-placeholder-pair-plus-backpatch, same idea as compile_def on fpga-lisp, here a literal C struct-field mutation instead of SETCDR")))
               (conformance . ((tier-1-constitutive . "10/10, tests/c_backend_conformance_test.rs")
                               (verified-against . "tests/fixtures/conformance.my, same fixture set the fpga-lisp pipeline uses")))
               (known-gaps . (no-eight-argument-limit-enforced-unlike-fpga-lisp-register-file
                              defmacro-supported-only-via-shared-macros-rs-not-macros-my))
               (differs-from-fpga-lisp . (equal?-is-structural-recursive-v-equal_p-here-vs-fpga-lisps-r11-worklist-but-both-independently-verified-correct
                                          no-eight-argument-register-ceiling-args-is-a-real-cons-list-not-fixed-registers))
               (error-handling . ((mechanism . "CompileError/MacroError enums, not panic!")
                                  (verified . "tests/c_backend_test.rs's 4 macro_*/nested_def_returns_graceful_error tests")))
               (not-wired-into-cml . "macros.my (a separate .my-hosted defmacro-expander, docs/tooling-language-priority.md) is unrelated to c-backend and not consumed by it either -- c-backend uses the same Rust macros.rs pipeline as fpga-lisp does"))))
